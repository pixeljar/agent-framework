{
  "_comment_for_claude_only": "NOT a file to copy verbatim. During /build-agent, take only the entries the user actually chose and MERGE them into the mcpServers object of the repo-root .mcp.json. Remote servers MUST include a 'type' (http/sse/ws) alongside 'url'. Never put real tokens here — reference ${VARS} and add the names to .env.example. Verify each server exists with /mcp before promising it works; many are illustrative shapes, not guaranteed-installed servers. Delete this _comment key from the real file.",

  "google-drive-example": {
    "type": "http",
    "url": "https://<google-drive-mcp-endpoint>/",
    "_note": "Google Drive/Sheets/Gmail typically sign in via a browser OAuth pop-up — no token pasted here."
  },

  "slack-example": {
    "type": "http",
    "url": "https://<slack-mcp-endpoint>/",
    "env": { "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}" }
  },

  "quickbooks-example": {
    "type": "http",
    "url": "https://<quickbooks-mcp-endpoint>/",
    "_note": "FINANCIAL — only include if interview Q8 was an explicit yes; pair with the reviewer subagent.",
    "env": { "QUICKBOOKS_ACCESS_TOKEN": "${QUICKBOOKS_ACCESS_TOKEN}" }
  },

  "local-stdio-example": {
    "command": "npx",
    "args": ["-y", "<some-mcp-server-package>"],
    "_note": "For a server you run locally (stdio). Use command/args instead of url/type."
  }
}

{
  "_comment_for_claude_only": "NOT a file to copy verbatim. During /build-agent, take only the entries the user actually chose and MERGE them into the mcpServers object of the repo-root .mcp.json. Remote servers MUST include a 'type' (http/sse/ws) alongside 'url', and pass any token in 'headers' — 'env' only works for local (stdio) servers. Never put real tokens here — reference ${VARS} and add the names to env.example; Claude Code does not read .env by itself, so tell the user to load it (README: 'Using a connector that needs a token'). Verify each server with `claude mcp list` before promising it works; many are illustrative shapes, not guaranteed-installed servers. Strip this _comment key AND every _note key before writing the real file.",

  "google-drive-example": {
    "type": "http",
    "url": "https://<google-drive-mcp-endpoint>/",
    "_note": "Google Drive/Sheets/Gmail typically sign in via a browser OAuth pop-up — no token, no headers."
  },

  "slack-example": {
    "type": "http",
    "url": "https://<slack-mcp-endpoint>/",
    "headers": { "Authorization": "Bearer ${SLACK_BOT_TOKEN}" }
  },

  "quickbooks-example": {
    "type": "http",
    "url": "https://<quickbooks-mcp-endpoint>/",
    "_note": "FINANCIAL — only include if the user said an explicit yes to the financial follow-up (interview Q3); pair with the reviewer subagent.",
    "headers": { "Authorization": "Bearer ${QUICKBOOKS_ACCESS_TOKEN}" }
  },

  "local-stdio-example": {
    "command": "npx",
    "args": ["-y", "<some-mcp-server-package>"],
    "env": { "SOME_API_KEY": "${SOME_API_KEY}" },
    "_note": "For a server you run locally (stdio). Use command/args instead of url/type; tokens go in env."
  }
}
